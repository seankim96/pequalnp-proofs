theorem inverse_certificate : H * J = (8090940 : ℤ) • (1 : Matrix (Fin 17) (Fin 17) ℤ) := by
  apply Matrix.ext
  intro i
  fin_cases i <;> as_aux_lemma => decide +kernel

def det4 (B : Matrix (Fin 4) (Fin 4) ℤ) : ℤ :=
    B 0 0 * (B 1 1 * B 2 2 * B 3 3 - B 1 1 * B 2 3 * B 3 2 + B 1 2 * B 2 3 * B 3 1 - B 1 2 * B 2 1 * B 3 3 + B 1 3 * B 2 1 * B 3 2 - B 1 3 * B 2 2 * B 3 1)
    - B 0 1 * (B 1 0 * B 2 2 * B 3 3 - B 1 0 * B 2 3 * B 3 2 + B 1 2 * B 2 3 * B 3 0 - B 1 2 * B 2 0 * B 3 3 + B 1 3 * B 2 0 * B 3 2 - B 1 3 * B 2 2 * B 3 0)
    + B 0 2 * (B 1 0 * B 2 1 * B 3 3 - B 1 0 * B 2 3 * B 3 1 + B 1 1 * B 2 3 * B 3 0 - B 1 1 * B 2 0 * B 3 3 + B 1 3 * B 2 0 * B 3 1 - B 1 3 * B 2 1 * B 3 0)
    - B 0 3 * (B 1 0 * B 2 1 * B 3 2 - B 1 0 * B 2 2 * B 3 1 + B 1 1 * B 2 2 * B 3 0 - B 1 1 * B 2 0 * B 3 2 + B 1 2 * B 2 0 * B 3 1 - B 1 2 * B 2 1 * B 3 0)

theorem det4_correct (B : Matrix (Fin 4) (Fin 4) ℤ) : B.det = det4 B := by
  rw [Matrix.det_succ_row_zero]
  simp only [Fin.sum_univ_four, Matrix.det_fin_three, Matrix.submatrix_apply, det4]
  norm_num [Fin.succAbove]
  ring

def minor (a b c d : Fin 16) : ℤ :=
  let f : Fin 4 → Fin 17 := ![a.castSucc, b.castSucc, c.castSucc, d.castSucc]
  det4 (J.submatrix f f)

theorem nonzero : ∀ a b c d : Fin 16, a < b → b < c → c < d → minor a b c d ≠ 0 := by
  have sweep : ∀ a b : Fin 16, a < b → ∀ c : Fin 16, b < c →
      ∀ d : Fin 16, c < d → minor a b c d ≠ 0 := by
    intro a b
    fin_cases a <;> fin_cases b <;> as_aux_lemma => decide +kernel
  exact fun a b c d hab hbc hcd => sweep a b hab c hbc d hcd
end PEqualNP.Research.PermanentSupportMinors

theorem PEqualNP.Research.PermanentSupportMinors : let H : Matrix (Fin 17) (Fin 17) ℤ :=
  ![![0, 0, 0, 0, 0, 5, 3, 3, 0, 3, 5, 3, 0, 3, 3, 5, 16],
   ![0, 0, 0, 0, 5, 0, 3, 3, 3, 0, 3, 2, 3, 0, 2, 3, 11],
   ![0, 0, 0, 0, 3, 3, 0, 2, 5, 3, 0, 3, 3, 2, 0, 3, 11],
   ![0, 0, 0, 0, 3, 3, 2, 0, 3, 2, 3, 0, 5, 3, 3, 0, 11],
   ![0, 5, 3, 3, 0, 0, 0, 0, 0, 3, 3, 2, 0, 3, 2, 3, 11],
   ![5, 0, 3, 3, 0, 0, 0, 0, 3, 0, 5, 3, 3, 0, 3, 5, 16],
   ![3, 3, 0, 2, 0, 0, 0, 0, 3, 5, 0, 3, 2, 3, 0, 3, 11],
   ![3, 3, 2, 0, 0, 0, 0, 0, 2, 3, 3, 0, 3, 5, 3, 0, 11],
   ![0, 3, 5, 3, 0, 3, 3, 2, 0, 0, 0, 0, 0, 2, 3, 3, 11],
   ![3, 0, 3, 2, 3, 0, 5, 3, 0, 0, 0, 0, 2, 0, 3, 3, 11],
   ![5, 3, 0, 3, 3, 5, 0, 3, 0, 0, 0, 0, 3, 3, 0, 5, 16],
   ![3, 2, 3, 0, 2, 3, 3, 0, 0, 0, 0, 0, 3, 3, 5, 0, 11],
   ![0, 3, 3, 5, 0, 3, 2, 3, 0, 2, 3, 3, 0, 0, 0, 0, 11],
   ![3, 0, 2, 3, 3, 0, 3, 5, 2, 0, 3, 3, 0, 0, 0, 0, 11],
   ![3, 2, 0, 3, 2, 3, 0, 3, 3, 3, 0, 5, 0, 0, 0, 0, 11],
   ![5, 3, 3, 0, 3, 5, 3, 0, 3, 3, 5, 0, 0, 0, 0, 0, 16],
   ![16, 11, 11, 11, 11, 16, 11, 11, 11, 11, 16, 11, 11, 11, 11, 16, 0]]
  ∃ J : Matrix (Fin 17) (Fin 17) ℤ,
    H * J = (8090940 : ℤ) • (1 : Matrix (Fin 17) (Fin 17) ℤ) ∧
    ∀ a b c d : Fin 16, a < b → b < c → c < d →
      let f : Fin 4 → Fin 17 := ![a.castSucc, b.castSucc, c.castSucc, d.castSucc]
      (J.submatrix f f).det ≠ 0 := by
  intro H
  refine ⟨PEqualNP.Research.PermanentSupportMinors.J, PEqualNP.Research.PermanentSupportMinors.inverse_certificate, ?_⟩
  intro a b c d hab hbc hcd
  intro f
  rw [PEqualNP.Research.PermanentSupportMinors.det4_correct]
  exact PEqualNP.Research.PermanentSupportMinors.nonzero a b c d hab hbc hcd
