private def pick (l i : Nat) := (table[l]! >>> (6*i)) &&& 63
set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
private theorem rowsOK : ∀ (l : Fin 31) (i : Fin 33), pick l.val i.val < 52 ∧
    (pos (pick l.val i.val)).testBit l.val = false ∧
    (i.val+1 < 33 → pick l.val i.val < pick l.val (i.val+1)) := by decide +kernel
private theorem increasing (l : Fin 31) (i j : Nat) (hlt : i < j) (hj : j < 33) :
    pick l.val i < pick l.val j := by
  induction j with
  | zero => omega
  | succ j ih =>
    have h := (rowsOK l ⟨j,by omega⟩).2.2 hj
    by_cases eq : i = j
    · subst i
      exact h
    · exact Nat.lt_trans (ih (by omega) (by omega)) h

