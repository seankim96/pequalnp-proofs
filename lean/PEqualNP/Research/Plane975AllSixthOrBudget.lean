open PEqualNP.Research.PlaneFirstAndSeparation PEqualNP.Research.PlaneFirstAndBudget
  PEqualNP.Research.Plane975AllSixthOrBudget in
theorem PEqualNP.Research.Plane975AllSixthOrBudget : ∀ (l r : Fin 31) (gs : List Gate) (o : Nat),
    let s := addOr base (l.val,r.val)
    (∀ p : Fin 52, wire (gs.foldl step s) o p.val = true) →
    (∀ n : Fin 468, wire (gs.foldl step s) o (52+n.val) = false) →
    9 ≤ gs.countP Prod.fst ∧ 6 ≤ gs.countP (fun g => !g.1) := by
  intro l r gs o
  dsimp only
  intro hp hn
  constructor
  · apply separated_bound _ gs o _ hp hn
    obtain ⟨idx,cert⟩ := PEqualNP.Research.Plane975ResidualSharedMask.diagonalSeparated 0
    refine ⟨idx,?_⟩
    intro i j lt
    obtain ⟨p,h⟩ := cert i j lt
    have baseOK : ∀ w ∈ base, good p.val (52+(idx i).val) (52+(idx j).val) w :=
      fun w mem => h w (List.mem_append_left _ mem)
    have read (k : Nat) : good p.val (52+(idx i).val) (52+(idx j).val) (wire base k) := by
      have T : good p.val (52+(idx i).val) (52+(idx j).val) (wire base k) := by
        unfold wire
        rw [List.getD_eq_getElem?_getD]
        cases e : base[k]? with
        | none => simp [good]
        | some w => exact baseOK w (List.mem_of_getElem? e)
      exact T
    refine ⟨p,?_⟩
    intro w mem
    rcases List.mem_append.mp mem with old | new
    · exact baseOK w old
    · obtain rfl := List.mem_singleton.mp new
      have hl := read l.val
      have hr := read r.val
      unfold good at *
      simp only [Bool.or_eq_true] at *
      tauto
  · let row (i : Fin 33) : Fin 52 := ⟨pick l.val i.val,(rowsOK l i).1⟩
    apply PEqualNP.Research.PlanePositiveOrBudget _ gs o row _ hp hn
    intro i j lt
    have lt' : (row i).val < (row j).val := increasing l i.val j.val lt j.isLt
    obtain ⟨bound,mask⟩ := checks (row i) (row j) lt'
    let n := witness (row i).val (row j).val
    refine ⟨⟨n,bound⟩,?_⟩
    have h : ∀ w ∈ base, w (row i).val = true → w (row j).val = true → w (52+n) = true := by
      intro w mem
      rcases List.mem_append.mp mem with old | const
      · obtain ⟨k,rfl⟩ := List.mem_ofFn.mp old
        have hi : (row i).val < 52 := (row i).isLt
        have hj : (row j).val < 52 := (row j).isLt
        simp only [input, if_pos hi, if_pos hj, show ¬52+n < 52 by omega, if_false,
          show 52+n-52 = n by omega]
        intro a b
        have hbit := congrArg (fun x : Nat => x.testBit k.val) mask
        simpa only [Nat.testBit_and,a,b,Bool.true_and] using hbit
      · simp only [List.mem_cons,List.not_mem_nil,or_false] at const
        rcases const with rfl | rfl <;> simp
    have off (t : Fin 33) : wire base l.val (row t).val = false := by
      unfold wire base
      rw [List.getD_eq_getElem?_getD]
      have b : l.val < (List.ofFn (fun j : Fin 31 => input j.val)).length := by simpa using l.isLt
      rw [List.getElem?_append_left b,List.getElem?_eq_getElem b,List.getElem_ofFn]
      simpa [input,(row t).isLt,row] using (rowsOK l t).2.1
    intro w mem
    rcases List.mem_append.mp mem with old | new
    · exact h w old
    · obtain rfl := List.mem_singleton.mp new
      simp only [off,Bool.false_or,Bool.or_eq_true]
      exact fun a b => Or.inr (readCovered h r.val a b)
