private theorem checks : ∀ i j : Fin 52, i.val < j.val →
    let n := witness i.val j.val
    n < 468 ∧ (pos i.val &&& pos j.val) &&& neg n = pos i.val &&& pos j.val := by
  decide +kernel

private theorem readCovered {s : List Column} {a b z : Nat}
    (h : ∀ w ∈ s, w a = true → w b = true → w z = true) (k : Nat) :
    wire s k a = true → wire s k b = true → wire s k z = true := by
  unfold wire
  rw [List.getD_eq_getElem?_getD]
  cases e : s[k]? with
  | none => simp
  | some w => exact h w (List.mem_of_getElem? e)
