open PEqualNP.Research.PlaneFirstAndSeparation PEqualNP.Research.PlaneFirstAndBudget PEqualNP.Research.PlaneCase35FourthOrBudget in
theorem PEqualNP.Research.PlaneCase35FourthOrBudget : ∀ (op₃ op₄ : Bool) (l r : Fin 28) (a b : Fin 29) (gs : List Gate) (o : Nat),
    let c := mix op₃ (input l.val) (input r.val)
    let d := mix op₄ (source c a) (source c b)
    let pool := List.ofFn (fun j : Fin 28 => input j.val) ++ [c, d, fun _ => false, fun _ => true]
    (∀ p : Fin 52, wire (gs.foldl step pool) o p.val = true) →
    (∀ n : Fin 468, wire (gs.foldl step pool) o (52+n.val) = false) →
    6 ≤ gs.countP (fun g => !g.1) := by
  intro op₃ op₄ l r a b gs o c d pool hp hn
  let k := pivot l a b
  let S := family \ (blocked l ∪ blocked k)
  have card : 33 ≤ S.card := by
    have h := Finset.le_card_sdiff (blocked l ∪ blocked k) family
    have u := Finset.card_union_le (blocked l) (blocked k)
    have h1 := block_size l
    have h2 := block_size k
    change 33 ≤ (family \ (blocked l ∪ blocked k)).card
    rw [family_size] at h
    omega
  let row := S.orderEmbOfCardLe card
  have mem (i : Fin 33) := Finset.mem_sdiff.mp (S.orderEmbOfCardLe_mem card i)
  have off (i : Fin 33) (v : Fin 28) (hv : v = l ∨ v = k) : input v.val (row i).val = false := by
    have hnot := (mem i).2
    have hf : row i ∈ family := (mem i).1
    simp only [Finset.mem_union, not_or] at hnot
    have hv' : row i ∉ blocked v := hv.elim (fun he => he ▸ hnot.1) (fun he => he ▸ hnot.2)
    simp only [blocked, Finset.mem_filter, hf, true_and, Bool.not_eq_true] at hv'
    simpa [input, (row i).isLt] using hv'
  apply PEqualNP.Research.PlanePositiveOrBudget _ gs o row _ hp hn
  intro i j hij
  have ord : row i < row j := row.strictMono hij
  obtain ⟨bn,hm⟩ := valid (row i) (row j) (mem i).1 (mem j).1 ord
  let z := witness (row i) (row j)
  refine ⟨⟨z,bn⟩,?_⟩
  have raw (u : Fin 28) : cover (row i).val (row j).val (52+z) (input u.val) := by
    unfold cover input
    simp only [ite_eq_left (row i).isLt, ite_eq_left (row j).isLt, show ¬52+z<52 by omega,
      ite_false, show 52+z-52=z by omega]
    intro h1 h2
    have bit := congrArg (fun x : Nat => x.testBit u.val) hm
    simpa only [Nat.testBit_and,h1,h2,Bool.true_and] using bit
  have hc : cover (row i).val (row j).val (52+z) c :=
    mix_off op₃ (off i l (Or.inl rfl)) (off j l (Or.inl rfl)) (raw r)
  have hd : cover (row i).val (row j).val (52+z) d :=
    fourth op₄ l a b c _ _ _ raw hc (off i k (Or.inr rfl)) (off j k (Or.inr rfl))
  intro w hw
  change w ∈ List.ofFn (fun u : Fin 28 => input u.val) ++ [c,d,fun _ => false,fun _ => true] at hw
  rcases List.mem_append.mp hw with old | extra
  · obtain ⟨u,rfl⟩ := List.mem_ofFn.mp old
    exact raw u
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at extra
    rcases extra with rfl | rfl | rfl | rfl
    · exact hc
    · exact hd
    · simp
    · simp
