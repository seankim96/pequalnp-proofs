def witness (i j : Fin 52) := (table[i.val]! >>> (9*j.val)) &&& 511

set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
theorem valid : ∀ i j : Fin 52, i ∈ family → j ∈ family → i < j →
    let k := witness i j
    k < 468 ∧ (pos i.val &&& pos j.val) &&& neg k = pos i.val &&& pos j.val := by
  decide +kernel

def blocked (k : Fin 28) := family.filter (fun p => (pos p.val).testBit k.val)
theorem block_size : ∀ k : Fin 28, (blocked k).card ≤ 8 := by decide +kernel
theorem family_size : family.card = 50 := by decide +kernel

def cover (p q z : Nat) (w : Column) := w p = true → w q = true → w z = true

theorem mix_off (op : Bool) {a b : Column} {p q z : Nat}
    (hp : a p = false) (hq : a q = false) (hb : cover p q z b) :
    cover p q z (mix op a b) := by
  unfold cover mix at *
  cases op <;> simp [hp, hq, Bool.or_eq_true]; tauto

theorem mix_comm (op : Bool) (a b : Column) : mix op a b = mix op b a := by
  funext t
  cases op <;> simp [mix, Bool.and_comm, Bool.or_comm]

def pivot (l : Fin 28) (a b : Fin 29) : Fin 28 :=
  if ha : a.val < 28 then ⟨a.val,ha⟩ else if hb : b.val < 28 then ⟨b.val,hb⟩ else l

theorem fourth (op : Bool) (l : Fin 28) (a b : Fin 29) (c : Column) (p q z : Nat)
    (hr : ∀ k : Fin 28, cover p q z (input k.val)) (hc : cover p q z c)
    (hp : input (pivot l a b).val p = false) (hq : input (pivot l a b).val q = false) :
    cover p q z (mix op (source c a) (source c b)) := by
  by_cases ha : a.val < 28
  · simp only [pivot, dite_eq_left ha] at hp hq
    simp only [source, ite_eq_left ha]
    apply mix_off op hp hq
    split
    · next h => exact hr ⟨_,h⟩
    · exact hc
  · by_cases hb : b.val < 28
    · simp only [pivot, dite_eq_right ha, dite_eq_left hb] at hp hq
      rw [mix_comm]
      simp only [source, ite_eq_left hb, ite_eq_right ha]
      exact mix_off op hp hq hc
    · simp only [source, ite_eq_right ha, ite_eq_right hb]
      have eq : mix op c c = c := by funext t; cases op <;> simp [mix]
      rwa [eq]

