open PEqualNP.Research.PlaneCase35FourOmissionCost in
theorem PEqualNP.Research.PlaneCase35FourOmissionCost : ∀ a b c d : Fin 48, a < b → b < c → c < d →
    96 + one a + one b + one c + one d +
      two a b + two a c + two a d + two b c + two b d + two c d +
      three a b c + three a b d + three a c d + three b c d + twoBound a b c d ≤ 206 := by
  intro a b c d hab hbc hcd
  have abc := scoreLe a b c hab hbc
  have abd := scoreLe a b d hab (Nat.lt_trans hbc hcd)
  have acd := scoreLe a c d (Nat.lt_trans hab hbc) hcd
  have bcd := scoreLe b c d hbc hcd
  have last := quadLe a b c d
  unfold score at abc abd acd bcd
  omega
