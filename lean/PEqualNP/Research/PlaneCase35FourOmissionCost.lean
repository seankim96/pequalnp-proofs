private theorem scoreLe (a b c : Fin 48) (h : a < b) (g : b < c) : score a b c ≤ 162 :=
  allScores c ⟨b.val,g⟩ ⟨a.val,h⟩
private theorem quadLe (a b c d : Nat) : twoBound a b c d ≤ 2 := by
  unfold twoBound
  dsimp only
  exact Nat.add_le_add (Nat.and_le_right (m := 1)) (Nat.and_le_right (m := 1))

