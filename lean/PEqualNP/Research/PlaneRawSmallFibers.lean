def required : Array Nat := #[0x6005, 0x1a016, 0x601d, 0xe015, 0x1e431]
def hits : Array (List (Nat × Nat)) := #[[(98, 99), (115, 116), (128, 129), (295, 296)], [(226, 231), (227, 230), (228, 229)], [(125, 126), (298, 299)], [(298, 302)], [(265, 268)]]
def fits (p x : Nat) := p &&& x == p
def clearAt (r x : Nat) := positive.toList.all fun p => fits p r || !fits p x
def matchesMask (r x : Nat) := fits r x && clearAt r x
private def pool : Array (List Nat) := #[[1, 40, 69, 98, 99, 100, 111, 115, 116, 117, 127, 128, 129, 148, 161, 294, 295, 296, 297, 319], [226, 227, 228, 229, 230, 231], [111, 125, 126, 298, 299, 306], [0, 112, 113, 114, 298, 300, 301, 302, 311, 312, 313, 314], [262, 264, 265, 266, 267, 268, 269]]
private def witnesses : Array Nat := #[, , , , ]

private def rejector (s i : Nat) := (witnesses[s]! >>> (6*i)) &&& 63
private def valid (s i : Nat) : Prop :=
  let k := rejector s i
  i ∈ pool[s]! ∨ (k < positive.size ∧ fits positive[k]! required[s]! = false ∧
    fits positive[k]! (negative[i]! ||| required[s]!) = true)
private instance (s i : Nat) : Decidable (valid s i) :=
  inferInstanceAs (Decidable (_ ∨ _ ∧ _ ∧ _))

private def admissible (s i : Nat) : Prop := i < 468 → valid s i
private instance (s i : Nat) : Decidable (admissible s i) := inferInstanceAs (Decidable (_ → _))

private theorem joinRows (s b n : Nat)
    (lo : ∀ j : Fin n, admissible s (b+j.val))
    (hi : ∀ j : Fin n, admissible s ((b+n)+j.val)) :
    ∀ j : Fin (n+n), admissible s (b+j.val) := by
  intro j
  by_cases h : j.val < n
  · exact lo ⟨j.val,h⟩
  · have h' := hi ⟨j.val-n,by omega⟩
    simpa only [show b+n+(j.val-n) = b+j.val by omega] using h'

set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
private theorem checked (s : Fin 5) (i : Fin 468) : valid s.val i.val := by
  have verified : ∀ j : Fin 512, admissible s.val (0+j.val) := by
    have cases : s.val = 0 ∨ s.val = 1 ∨ s.val = 2 ∨ s.val = 3 ∨ s.val = 4 := by omega
    rcases cases with h | h | h | h | h <;> rw [h]
    all_goals apply joinRows _ 0 256
    all_goals apply joinRows _ _ 128
    all_goals apply joinRows _ _ 64
    all_goals apply joinRows _ _ 32
    all_goals apply joinRows _ _ 16
    all_goals apply joinRows _ _ 8
    all_goals as_aux_lemma => decide +kernel
  have h := verified ⟨i.val,by omega⟩
  simpa only [Nat.zero_add] using h (by simpa only [Nat.zero_add] using i.isLt)

private def scan (s : Nat) := ((pool[s]!).product (pool[s]!)).filter fun z =>
  decide (z.1 < z.2) && matchesMask required[s]! (negative[z.1]! ||| negative[z.2]!)
set_option maxRecDepth 8192 in
set_option maxHeartbeats 0 in
private theorem exactTable : ∀ s : Fin 5, scan s.val = hits[s.val]! := by decide +kernel

private theorem bitwise (p x : Nat) : fits p x = true ↔ ∀ j, p.testBit j = true → x.testBit j = true := by
  unfold fits
  rw [beq_iff_eq]
  constructor
  · intro h j yes
    have e := congrArg (fun n : Nat => n.testBit j) h
    simpa only [Nat.testBit_and,yes,Bool.true_and] using e
  · intro h
    apply Nat.eq_of_testBit_eq
    intro j
    rw [Nat.testBit_and]
    cases eq : p.testBit j with
    | false => simp
    | true => simp [h j eq]

private theorem member (s : Fin 5) (i : Fin 468) (u : Nat)
    (sub : ∀ j, (negative[i.val]!).testBit j = true → u.testBit j = true)
    (matchU : matchesMask required[s.val]! u = true) : i.val ∈ pool[s.val]! := by
  rcases checked s i with mem | ⟨lt,off,yes⟩
  · exact mem
  · obtain ⟨core,clear⟩ := Bool.and_eq_true_iff.mp matchU
    let k := rejector s.val i.val
    have posmem : positive[k]! ∈ positive.toList := by
      rw [getElem!_pos positive k (show k < positive.size from lt)]
      exact Array.getElem_mem_toList lt
    have on : fits positive[k]! u = true := by
      apply (bitwise _ _).mpr
      intro j hit
      have incl := (bitwise _ _).mp yes j hit
      rw [Nat.testBit_or,Bool.or_eq_true] at incl
      exact incl.elim (sub j) ((bitwise _ _).mp core j)
    have impossible := List.all_eq_true.mp clear _ posmem
    change (fits positive[k]! required[s.val]! || !fits positive[k]! u) = true at impossible
    change fits positive[k]! required[s.val]! = false at off
    simp [off,on] at impossible

end PEqualNP.Research.PlaneRawSmallFibers

open PEqualNP.Research.PlaneRawSmallFibers in
theorem PEqualNP.Research.PlaneRawSmallFibers : ∀ (s : Fin 5) (a b : Fin 468), a.val < b.val →
    (matchesMask required[s.val]! (negative[a.val]! ||| negative[b.val]!) = true ↔
      (a.val,b.val) ∈ hits[s.val]!) := by
  intro s a b lt
  rw [← exactTable s]
  simp only [scan,List.mem_filter,Bool.and_eq_true,decide_eq_true_eq,lt,true_and]
  constructor
  · intro m
    exact ⟨List.mem_product.mpr ⟨member s a _ (fun j h => by simp [Nat.testBit_or,h]) m,
      member s b _ (fun j h => by simp [Nat.testBit_or,h]) m⟩,m⟩
  · exact fun h => h.2
