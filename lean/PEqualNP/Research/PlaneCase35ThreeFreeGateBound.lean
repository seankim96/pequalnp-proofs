    (∀ m : Fin 468, wire (gs.foldl step pool) o (52+m.val) = false) →
    9 ≤ gs.countP Prod.fst := PEqualNP.Research.PlaneCase35ThreeFreeGateBound.C PEqualNP.Research.PlaneCase35ThreeFreeGateBound.finiteCertificate
