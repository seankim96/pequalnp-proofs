private theorem rowData (j : Fin 468) : validMetadata j.val := by
  have batches (a : Fin 39) (b : Fin 12) : validMetadata (12*a.val+b.val) := by
    match a with
    | ⟨0,_⟩ => exact data0 b
    | ⟨1,_⟩ => exact data1 b
    | ⟨2,_⟩ => exact data2 b
    | ⟨3,_⟩ => exact data3 b
    | ⟨4,_⟩ => exact data4 b
    | ⟨5,_⟩ => exact data5 b
    | ⟨6,_⟩ => exact data6 b
    | ⟨7,_⟩ => exact data7 b
    | ⟨8,_⟩ => exact data8 b
    | ⟨9,_⟩ => exact data9 b
    | ⟨10,_⟩ => exact data10 b
    | ⟨11,_⟩ => exact data11 b
    | ⟨12,_⟩ => exact data12 b
    | ⟨13,_⟩ => exact data13 b
    | ⟨14,_⟩ => exact data14 b
    | ⟨15,_⟩ => exact data15 b
    | ⟨16,_⟩ => exact data16 b
    | ⟨17,_⟩ => exact data17 b
    | ⟨18,_⟩ => exact data18 b
    | ⟨19,_⟩ => exact data19 b
    | ⟨20,_⟩ => exact data20 b
    | ⟨21,_⟩ => exact data21 b
    | ⟨22,_⟩ => exact data22 b
    | ⟨23,_⟩ => exact data23 b
    | ⟨24,_⟩ => exact data24 b
    | ⟨25,_⟩ => exact data25 b
    | ⟨26,_⟩ => exact data26 b
    | ⟨27,_⟩ => exact data27 b
