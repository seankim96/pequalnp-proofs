    | ⟨12,_⟩ => exact row12 b
    | ⟨13,_⟩ => exact row13 b
    | ⟨14,_⟩ => exact row14 b
    | ⟨15,_⟩ => exact row15 b
    | ⟨16,_⟩ => exact row16 b
    | ⟨17,_⟩ => exact row17 b
    | ⟨18,_⟩ => exact row18 b
    | ⟨19,_⟩ => exact row19 b
    | ⟨20,_⟩ => exact row20 b
    | ⟨21,_⟩ => exact row21 b
    | ⟨22,_⟩ => exact row22 b
    | ⟨23,_⟩ => exact row23 b
    | ⟨24,_⟩ => exact row24 b
    | ⟨25,_⟩ => exact row25 b
    | ⟨26,_⟩ => exact row26 b
    | ⟨27,_⟩ => exact row27 b
    | ⟨28,_⟩ => exact row28 b
    | ⟨29,_⟩ => exact row29 b
    | ⟨30,_⟩ => exact row30 b
    | ⟨31,_⟩ => exact row31 b
    | ⟨32,_⟩ => exact row32 b
    | ⟨33,_⟩ => exact row33 b
    | ⟨34,_⟩ => exact row34 b
    | ⟨35,_⟩ => exact row35 b
    | ⟨36,_⟩ => exact row36 b
    | ⟨37,_⟩ => exact row37 b
    | ⟨38,_⟩ => exact row38 b
    | ⟨v+39,h⟩ => omega
  have h := batches ⟨j.val/12,by omega⟩ ⟨j.val%12,by omega⟩
  simpa only [Nat.div_add_mod] using h

private theorem countSpec (i j : Nat) (ps : List Nat) :
    let c := counts i ps
    let k := (ps.filter fun p => (cov i p).testBit j).length
    (c.1.testBit j = true ↔ 1 ≤ k) ∧ (c.2.1.testBit j = true ↔ 2 ≤ k) ∧
    (c.2.2.1.testBit j = true ↔ 3 ≤ k) ∧ (c.2.2.2.1.testBit j = true ↔ 4 ≤ k) ∧
    (c.2.2.2.2.testBit j = true ↔ 5 ≤ k) := by
  induction ps with
  | nil => simp [counts]
  | cons p ps ih =>
    dsimp only at ih ⊢
    simp only [counts,List.foldr_cons,bump,Nat.testBit_or,Nat.testBit_and,Bool.or_eq_true,Bool.and_eq_true] at *
    rcases ih with ⟨h1,h2,h3,h4,h5⟩
    cases e : (cov i p).testBit j <;> simp [e,h1,h2,h3,h4,h5] <;> omega

private theorem orMem (i j : Nat) (ms : List Nat)
    (hit : (ms.foldr (fun m w => rowMask i m ||| w) 0).testBit j = true) :
    ∃ m ∈ ms, (rowMask i m).testBit j = true := by
  induction ms with
  | nil => simp at hit
  | cons m ms ih =>
    rw [List.foldr_cons,Nat.testBit_or,Bool.or_eq_true] at hit
    rcases hit with hit | hit
    · exact ⟨m,by simp,hit⟩
    · obtain ⟨q,hq,on⟩ := ih hit
      exact ⟨q,List.mem_cons_of_mem _ hq,on⟩

private theorem andMem (i j : Nat) (ps : List Nat)
    (hit : (ps.foldr (fun p w => cov i p &&& w) full).testBit j = true) :
    ∀ p ∈ ps, (cov i p).testBit j = true := by
  induction ps with
  | nil => simp
  | cons p ps ih =>
    simp only [List.foldr_cons,Nat.testBit_and,Bool.and_eq_true] at hit
    intro q hq
    rcases List.mem_cons.mp hq with rfl | mem
    · exact hit.1
    · exact ih hit.2 q mem

