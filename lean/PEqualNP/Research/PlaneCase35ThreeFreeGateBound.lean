private def highs := (List.range 48).map (·+4)
private abbrev Counts := Nat × Nat × Nat × Nat × Nat
private def bump (v : Nat) (c : Counts) : Counts :=
  (c.1 ||| v, c.2.1 ||| (c.1 &&& v), c.2.2.1 ||| (c.2.1 &&& v),
   c.2.2.2.1 ||| (c.2.2.1 &&& v), c.2.2.2.2 ||| (c.2.2.2.1 &&& v))
private def counts (i : Nat) (ps : List Nat) : Counts :=
  ps.foldr (fun p c => bump (cov i p) c) (0,0,0,0,0)
private def rowMask (i m : Nat) := (highs.filter (fun p => m.testBit (p-4))).foldr
  (fun p w => cov i p &&& w) full
private def bucketsCover (i : Nat) := labels[i]!.foldr (fun m w => rowMask i m ||| w) 0
private def valid (i : Nat) : Prop :=
  (((counts i highs).2.2.2.2 ||| bucketsCover i) &&& (2^i-1)) = 2^i-1
