private theorem allRows (j : Fin 468) : valid j.val := by
  have batches (a : Fin 39) (b : Fin 12) : valid (12*a.val+b.val) := by
    match a with
    | ⟨0,_⟩ => exact row0 b
    | ⟨1,_⟩ => exact row1 b
    | ⟨2,_⟩ => exact row2 b
    | ⟨3,_⟩ => exact row3 b
    | ⟨4,_⟩ => exact row4 b
    | ⟨5,_⟩ => exact row5 b
