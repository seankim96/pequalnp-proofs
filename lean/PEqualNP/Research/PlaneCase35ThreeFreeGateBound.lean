open PEqualNP.Research.PlaneCase35ThreeFreeGateBound.P.PlaneCase35SixthCharge PEqualNP.Research.PlaneCase35ThreeFreeGateBound.P.PlaneCase35SixthExceptions.PairShape in
theorem PEqualNP.Research.PlaneCase35ThreeFreeGateBound.P : ∀ i j : Fin 468, i < j →
    let good (q : Nat) := ∀ k : Fin 30, base k (q+4) = true →
      base k (52+i.val) = true ∨ base k (52+j.val) = true
    (∃ ps : List Nat, ps.Nodup ∧ 5 ≤ ps.length ∧ ∀ q ∈ ps, q < 48 ∧ good q) ∨
      ∃ m ∈ labels[j.val]!, ∀ q : Fin 48, m.testBit q.val = true → good q.val := by
  intro i j lt good
  have eq := congrArg (fun x : Nat => x.testBit i.val) (allRows j)
  have low : (2^j.val-1 : Nat).testBit i.val = true := by simp [Nat.testBit_two_pow_sub_one,lt]
  simp only [Nat.testBit_and,Nat.testBit_or,low,Bool.and_true,Bool.or_eq_true] at eq
  have sound (q : Nat) (h : q < 48) (bit : (cov j.val (q+4)).testBit i.val = true) : good q := by
    have v := covSound j i ⟨q+4,by omega⟩ bit
    intro k hk
    exact (v k hk).symm
  rcases eq with many | some
  · left
    let l := (List.range 48).filter fun q => (cov j.val (q+4)).testBit i.val
    refine ⟨l,List.Nodup.filter _ List.nodup_range,?_,?_⟩
    · have cnt := (countSpec j.val i.val highs).2.2.2.2.mp many
      simpa [highs,List.filter_map,l,Function.comp_def] using cnt
    · intro q hq
      obtain ⟨inside,bit⟩ := List.mem_filter.mp hq
      exact ⟨List.mem_range.mp inside,sound q (List.mem_range.mp inside) bit⟩
  · right
    obtain ⟨m,mem,hit⟩ := orMem j.val i.val _ some
    refine ⟨m,mem,?_⟩
    intro q on
    apply sound q.val q.isLt
    apply andMem j.val i.val _ hit
    apply List.mem_filter.mpr
    exact ⟨List.mem_map.mpr ⟨q.val,List.mem_range.mpr q.isLt,rfl⟩,by simpa using on⟩

namespace PEqualNP.Research.PlaneCase35ThreeFreeGateBound.C
abbrev Term := Finset (Fin 6)
abbrev Form := List Term

def atom (i : Fin 6) : Form := [{i}]
def combine (op : Bool) (x y : Form) : Form :=
  if op then x.flatMap (fun m => y.map (fun n => m ∪ n)) else x ++ y
def choose (k : Fin 3) (fresh x y : Form) : Form :=
  if k = 0 then fresh else if k = 1 then x else y
def pick (k : Fin 3) (fresh x y : Bool) : Bool :=
  if k = 0 then fresh else if k = 1 then x else y
def gate (op x y : Bool) : Bool := if op then x && y else x || y
def eval (v : Term) (xs : Form) : Bool := xs.any fun t => decide (t ⊆ v)

private theorem count : ∀ (a b c l r : Bool) (i j : Fin 3),
    let x := combine a (atom 0) (atom 1)
    let y := combine b (if l then x else atom 2) (if r then x else atom 3)
    let z := combine c (choose i (atom 4) x y) (choose j (atom 5) x y)
    ((x ++ y ++ z).eraseDups.filter (fun t => 1 < t.card)).length ≤ 4 := by
  set_option maxRecDepth 20000 in
  set_option maxHeartbeats 0 in
  decide +kernel

private theorem evalAtom (v : Term) (i : Fin 6) : eval v (atom i) = decide (i ∈ v) := by
  simp [eval, atom]

private theorem evalCombine (v : Term) (op : Bool) (x y : Form) :
    eval v (combine op x y) = gate op (eval v x) (eval v y) := by
  cases op
  · simp [eval,combine,gate]
  · apply Bool.eq_iff_iff.mpr
    simp [eval,combine,gate,List.any_eq_true,Finset.union_subset_iff]
    aesop

private theorem evalChoose (v : Term) (k : Fin 3) (f x y : Form) :
    eval v (choose k f x y) = pick k (eval v f) (eval v x) (eval v y) := by
  unfold choose pick
  by_cases h : k = 0 <;> by_cases g : k = 1 <;> simp [h,g]

end PEqualNP.Research.PlaneCase35ThreeFreeGateBound.C
open PEqualNP.Research.PlaneCase35ThreeFreeGateBound.C in
theorem PEqualNP.Research.PlaneCase35ThreeFreeGateBound.C.normalForm : ∀ (op₁ op₂ op₃ useLeft useRight : Bool) (left right : Fin 3),
    let x := combine op₁ (atom 0) (atom 1)
    let y := combine op₂ (if useLeft then x else atom 2) (if useRight then x else atom 3)
    let z := combine op₃ (choose left (atom 4) x y) (choose right (atom 5) x y)
    ((x ++ y ++ z).eraseDups.filter (fun t => 1 < t.card)).length ≤ 4 ∧
    ∀ v : Finset (Fin 6),
      let b (i : Fin 6) := decide (i ∈ v)
      let u := gate op₁ (b 0) (b 1)
      let w := gate op₂ (if useLeft then u else b 2) (if useRight then u else b 3)
      eval v x = u ∧ eval v y = w ∧
        eval v z = gate op₃ (pick left (b 4) u w) (pick right (b 5) u w) := by
  intro a b c l r i j x y z
  refine ⟨count a b c l r i j, ?_⟩
  intro v bit u w
  have hx : eval v x = u := by simp [x,u,bit,evalCombine,evalAtom]
  have hy : eval v y = w := by cases l <;> cases r <;> simp [y,w,bit,evalCombine,evalAtom,hx]
  exact ⟨hx,hy,by simp [z,evalCombine,evalChoose,evalAtom,hx,hy,bit]⟩

