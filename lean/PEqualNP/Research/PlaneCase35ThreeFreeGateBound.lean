private def terms (v : Nat) := ([v%64,(v/64)%64,(v/4096)%64,(v/262144)%64] : List Nat).filter (· < 48)
private def fee : List Nat → Nat
  | [] => 96
  | [a] => one a
  | [a,b] => two a b
  | [a,b,c] => three a b c
  | [a,b,c,d] => twoBound a b c d
  | _ => 0
private def keySum (xs : List Nat) := (xs.map (fun x => 2^x)).sum
private def validMetadata (j : Nat) := ∀ h : Fin (labels[j]!).length,
  let m := (labels[j]!)[h.val]!
  let v := (metadata[j]!)[h.val]!
  let xs := terms v
  xs.Pairwise (· < ·) ∧ keySum xs = m ∧
  (∀ q ∈ xs, m.testBit q = true) ∧ v/2^24 < fee xs ∧
  ((packed m >>> (9*(v/2^24))) &&& 511) = j
