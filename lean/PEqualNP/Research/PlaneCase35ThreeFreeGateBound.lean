    | ⟨33,_⟩ => exact data33 b
    | ⟨34,_⟩ => exact data34 b
    | ⟨35,_⟩ => exact data35 b
    | ⟨36,_⟩ => exact data36 b
    | ⟨37,_⟩ => exact data37 b
    | ⟨38,_⟩ => exact data38 b
    | ⟨v+39,h⟩ => omega
  have h := batches ⟨j.val/12,by omega⟩ ⟨j.val%12,by omega⟩
  simpa only [Nat.div_add_mod] using h

private theorem slotMem (j : Fin 468) (m : Nat) (hm : m ∈ labels[j.val]!) :
    ∃ xs : List Nat, xs.Pairwise (· < ·) ∧ (∀ q ∈ xs, q < 48 ∧ m.testBit q = true) ∧
      j ∈ bucket (keySum xs) (fee xs) := by
  obtain ⟨h,hh,eq⟩ := List.getElem_of_mem hm
  have e : (labels[j.val]!)[h]! = m := by simpa [hh] using eq
  let v := (metadata[j.val]!)[h]!
  obtain ⟨order,sum,bits,slot,pos⟩ := rowData j ⟨h,hh⟩
  refine ⟨terms v,order,?_,?_⟩
  · intro q hq
    exact ⟨by simpa using (List.mem_filter.mp hq).2,by simpa only [e] using bits q hq⟩
  · rw [sum]
    refine Finset.mem_image.mpr ⟨v/2^24,Finset.mem_range.mpr slot,?_⟩
    apply Fin.ext
    change (((packed _ >>> (9*(v/2^24))) &&& 511) % 468) = j.val
    rw [pos,Nat.mod_eq_of_lt j.isLt]

private theorem inside (a b c d : Fin 48) (xs : List Nat)
    (sub : xs.Sublist [a.val,b.val,c.val,d.val]) (j : Fin 468)
    (hit : j ∈ bucket (keySum xs) (fee xs)) : j ∈ dropped a b c d := by
  have h := List.mem_sublists'.mpr sub
  simp only [List.sublists'_cons,List.sublists'_nil,List.map_append,List.map_cons,List.map_nil,
    List.nil_append,List.cons_append,List.mem_cons,List.not_mem_nil,or_false,List.mem_append] at h
  simp only [dropped,Finset.mem_union]
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals simp only [keySum,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,Nat.add_zero,fee] at hit
  all_goals simp_all only [Nat.add_assoc,or_true,true_or]

private theorem quartet (S : Finset (Fin 52)) (hS : S.card ≤ 4) :
    ∃ a b c d : Fin 48, a < b ∧ b < c ∧ c < d ∧
      ∀ (u : Fin 48), (⟨u.val+4,by omega⟩ : Fin 52) ∈ S → u.val ∈ [a.val,b.val,c.val,d.val] := by
  let project (p : Fin 52) : Fin 48 := ⟨(p.val-4)%48,Nat.mod_lt _ (by decide)⟩
  let U := S.image project
  have cardU : U.card ≤ 4 := Finset.card_image_le.trans hS
  obtain ⟨T,hUT,_,four⟩ := Finset.exists_subsuperset_card_eq (Finset.subset_univ U) cardU (show 4 ≤ (Finset.univ : Finset (Fin 48)).card by decide)
  let e := T.orderEmbOfFin four
  refine ⟨e 0,e 1,e 2,e 3,e.strictMono (by decide),e.strictMono (by decide),e.strictMono (by decide),?_⟩
  intro u hu
  have eq : project ⟨u.val+4,by omega⟩ = u := by
    apply Fin.ext
    simp [project,Nat.mod_eq_of_lt u.isLt]
  have mem : u ∈ T := hUT (eq ▸ Finset.mem_image_of_mem project hu)
  have range : u ∈ Set.range e := by simpa [e,Finset.range_orderEmbOfFin] using mem
  obtain ⟨v,rfl⟩ := range
  fin_cases v <;> simp

private theorem finiteCertificate (S : Finset (Fin 52)) (small : S.card ≤ 4) :
    ∃ K : Finset (Fin 468), 257 ≤ K.card ∧
    ∀ i j : K, i.val < j.val → ∃ p : Fin 52, 4 ≤ p.val ∧ p ∉ S ∧
      ∀ k : Fin 30, C.Base.base k p.val = true →
        C.Base.base k (52+i.val.val) = true ∨ C.Base.base k (52+j.val.val) = true := by
  obtain ⟨a,b,c,d,ab,bc,cd,cover⟩ := quartet S small
  let Q := [a.val,b.val,c.val,d.val]
  let K := Finset.univ \ dropped a b c d
  have size := B a b c d ab bc cd
  refine ⟨K,(by decide : 257 ≤ 262).trans size,?_⟩
  intro i j lt
  rcases P i.val j.val lt with ⟨ps,unique,big,good⟩ | ⟨m,hm,good⟩
  · have outside : ∃ q ∈ ps, q ∉ Q := by
      by_contra! h
      have sub : ps.toFinset ⊆ Q.toFinset := by
        intro q hq
        exact List.mem_toFinset.mpr (h q (List.mem_toFinset.mp hq))
      have le := Finset.card_le_card sub
      rw [List.toFinset_card_of_nodup unique] at le
      have cap : Q.toFinset.card ≤ 4 := List.toFinset_card_le Q
      omega
    obtain ⟨q,hq,out⟩ := outside
    obtain ⟨lim,pass⟩ := good q hq
    let u : Fin 48 := ⟨q,lim⟩
    exact ⟨⟨q+4,by omega⟩,by simp,fun h => out (cover u h),pass⟩
  · obtain ⟨xs,sorted,flags,mem⟩ := slotMem j.val m hm
    have outside : ∃ q ∈ xs, q ∉ Q := by
      by_contra! h
      have sortQ : Q.Pairwise (· < ·) := by
        simp [Q,List.pairwise_cons] <;> omega
      have sub := List.sublist_of_subperm_of_pairwise (List.subperm_of_subset sorted.nodup h) sorted sortQ
      exact (Finset.mem_sdiff.mp j.property).2 (inside a b c d xs sub j.val mem)
    obtain ⟨q,hq,out⟩ := outside
    obtain ⟨lim,bit⟩ := flags q hq
    let u : Fin 48 := ⟨q,lim⟩
    exact ⟨⟨q+4,by omega⟩,by simp,fun h => out (cover u h),good u bit⟩
