open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing.Core in
theorem Normalized.Packing : ∀ (m : Nat) (clauses : Fin m → List Nat),
  (∀ k c, (clauses c).any ((sig (pos k)).testBit) = true) →
  (∀ i, ∃ c, (clauses c).any ((sig (neg i)).testBit) = false) → 264 ≤ m := by
  intro m clauses positive negative
  classical
  choose reject rejected using negative
  have inj : Function.Injective reject := by
    intro i j same
    by_contra distinct
    obtain ⟨l, mem, hl⟩ := List.any_eq_true.mp (positive (pivot i j) (reject i))
    rw [pos_ok] at hl
    have e := congrArg (fun a : Nat => a.testBit l) (pairs_ok i j distinct)
    simp [Nat.testBit_and, Nat.testBit_or, hl] at e
    rcases e with hi | hj
    · rw [← neg_ok] at hi
      have hit := List.any_eq_true.mpr ⟨l, mem, hi⟩
      simp [rejected i] at hit
    · rw [← neg_ok] at hj
      rw [same] at mem
      have hit := List.any_eq_true.mpr ⟨l, mem, hj⟩
      simp [rejected j] at hit
  simpa using Fintype.card_le_of_injective reject inj

namespace Normalized.Expansion.Core
abbrev Side := List (Nat × Bool)
abbrev Row := Nat → Bool
def hit (s : Side) (g : Bool) (r : Row) := s.any (fun l => r l.1 && (!l.2 || g))
def push (r : Row) (v : Bool) : Row := fun i => if i = 0 then v else r (i-1)
def step (g : Bool) (r : Row) (gate : Side × Side) :=
  push r (hit gate.1 g r && hit gate.2 g r)

private def plug (new : Side) (s : Side) : Side :=
  s.flatMap (fun l => if l.1 = 0 then new.map (fun t => (t.1, t.2 || l.2))
    else [(l.1-1, l.2)])

private theorem plug_hit (new s : Side) (g : Bool) (r : Row) :
    hit (plug new s) g r = hit s g (push r (hit new g r)) := by
  induction s with
  | nil => rfl
  | cons l ls ih =>
    rcases l with ⟨k,b⟩
    cases k with
    | zero =>
      simp only [plug, List.flatMap_cons, if_pos rfl, hit, List.any_append, List.any_map,
        List.any_cons, push, Function.comp_def] at *
      cases b <;> cases g <;> simp_all [Bool.and_assoc, Function.comp_def] <;> rfl
    | succ k =>
      simp only [plug, List.flatMap_cons, Nat.succ_ne_zero, if_false, List.singleton_append,
        hit, List.any_cons, push] at *
      simp_all

private theorem hit_mono (s : Side) (g : Bool) (r : Row) :
    hit s g (push r false) = true → hit s g (push r true) = true := by
  simp only [hit, List.any_eq_true, Bool.and_eq_true]
  rintro ⟨l, hl, a, b⟩
  refine ⟨l, hl, ?_, b⟩
  by_cases h : l.1 = 0 <;> simp_all [push]

private theorem meet_hit (s : Side) (g : Bool) (r : Row) (a b : Bool) :
    hit s g (push r (a && b)) = (hit s g (push r a) && hit s g (push r b)) := by
  have h := hit_mono s g r
  cases a <;> cases b <;> simp_all <;>
    cases ha : hit s g (push r false) <;> cases hb : hit s g (push r true) <;> simp_all

private theorem allBoth {α : Type} (cs : List α) (f h : α → Bool) :
    cs.all (fun s => f s && h s) = (cs.all f && cs.all h) := by
  induction cs with
  | nil => rfl
  | cons a cs ih => simp [ih, Bool.and_assoc, Bool.and_comm, Bool.and_left_comm]
end Normalized.Expansion.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion.Core in
theorem Normalized.Expansion : ∀ (gates : List (Side × Side)) (out : Side),
  ∃ clauses : List Side, clauses.length = 2 ^ gates.length ∧
    ∀ (g : Bool) (r : Row), hit out g (gates.foldl (step g) r) = clauses.all (fun s => hit s g r) := by
  intro gates
  induction gates with
  | nil =>
    intro out
    exact ⟨[out], by simp, by simp⟩
  | cons gate gates ih =>
    intro out
    obtain ⟨cs, size, spec⟩ := ih out
    refine ⟨cs.map (plug gate.1) ++ cs.map (plug gate.2), ?_, ?_⟩
    · simp only [List.length_append, List.length_map, size, List.length_cons]
      rw [Nat.pow_succ, Nat.mul_two]
    · intro g r
      rw [List.foldl_cons, spec]
      simp only [List.all_append, List.all_map, Function.comp_def, plug_hit]
      simp only [step, meet_hit, allBoth]

namespace Normalized.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing.Core

def initial (v : Nat) : Row := fun i => decide (i < 33) && v.testBit i
def eval (gates : List (Side × Side)) (out : Side) (v : Nat) :=
  let g := v.testBit 32
  hit out g (gates.foldl (step g) (initial v))
private def encoded (s : Side) : List Nat :=
  (s.filter (fun l => l.1 < 33)).map (fun l => if l.2 then 33+l.1 else l.1)
private def consistent (v : Nat) : Prop :=
  v >>> 33 = (if v.testBit 32 then v % (2^33) else 0)
private instance (v : Nat) : Decidable (consistent v) := by unfold consistent; infer_instance
private theorem encoded_hit (v : Nat) (h : consistent v) (s : Side) :
    (encoded s).any v.testBit = hit s (v.testBit 32) (initial v) := by
  induction s with
  | nil => rfl
  | cons l s ih =>
    rcases l with ⟨i,b⟩
    by_cases hi : i < 33
    · have hb := congrArg (fun w : Nat => w.testBit i) h
      change (v >>> 33).testBit i = (if v.testBit 32 then v % (2^33) else 0).testBit i at hb
      have low : (v % 8589934592).testBit i = v.testBit i := by
        exact (Nat.testBit_mod_two_pow v 33 i).trans (by simp [hi])
      cases b <;> cases hg : v.testBit 32 <;> simp_all [encoded, hit, initial]
    · simp_all [encoded, hit, initial]
set_option maxRecDepth 40000 in
set_option maxHeartbeats 0 in
private theorem pos_consistent : ∀ k, consistent (sig (pos k)) := by
  intro k
  rw [pos_ok]
  exact (by decide : ∀ i, consistent (pm i)) k
set_option maxRecDepth 40000 in
set_option maxHeartbeats 0 in
private theorem neg_consistent : ∀ k, consistent (sig (neg k)) := by
  intro k
  rw [neg_ok]
  exact (by decide : ∀ i, consistent (nm i)) k
end Normalized.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Core PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion.Core
  PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing.Core in
theorem Normalized :
  ∀ (gates : List (Side × Side)) (out : Side),
    (∀ k, eval gates out (sig (pos k)) = true) →
    (∀ i, eval gates out (sig (neg i)) = false) → 9 ≤ gates.length := by
  intro gates out positive negative
  obtain ⟨cs, size, expansion⟩ := PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion gates out
  have lower := PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing cs.length
    (fun c => encoded cs[c.val])
  have bound : 264 ≤ cs.length := by
    apply lower
    · intro k c
      have hk := positive k
      unfold eval at hk
      rw [expansion] at hk
      rw [encoded_hit _ (pos_consistent k)]
      exact List.all_eq_true.mp hk _ (List.getElem_mem c.isLt)
    · intro i
      have hi := negative i
      unfold eval at hi
      rw [expansion] at hi
      obtain ⟨s, mem, miss⟩ := List.all_eq_false.mp hi
      obtain ⟨j, hj, eq⟩ := List.getElem_of_mem mem
      refine ⟨⟨j,hj⟩, ?_⟩
      rw [encoded_hit _ (neg_consistent i), eq]
      simpa using miss
  rw [size] at bound
  by_contra! small
  have upper : 2^gates.length ≤ (2:Nat)^8 := Nat.pow_le_pow_right (by decide) (by omega)
  omega
namespace Physical
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion.Core
abbrev Gate := Bool × Nat × Nat
abbrev Bindings := Nat → Side
def write {α : Type} (r : Nat → α) (n : Nat) (v : α) := fun i => if i = n then v else r i
def physical (s : Row) (t : Gate) := if t.1 then s t.2.1 && s t.2.2 else s t.2.1 || s t.2.2
def run (s : Row) (n : Nat) (gs : List Gate) : Row :=
  match gs with
  | [] => s
  | t :: tail => run (write s n (physical s t)) (n+1) tail
def shiftSide (s : Side) : Side := s.map (fun p => (p.1+1,p.2))
def maskSide (s : Side) : Side := s.map (fun p => (p.1,true))
private theorem shift_hit (s : Side) (g b : Bool) (r : Row) :
    hit (shiftSide s) g (push r b) = hit s g r := by
  simp [shiftSide, hit, push, Function.comp_def]
private theorem mask_hit (s : Side) (g : Bool) (r : Row) :
    hit (maskSide s) g r = (hit s g r && g) := by
  cases g <;> simp [hit,maskSide,Function.comp_def]
def classify (t : Gate) : Option Nat :=
  if t.2.1 = 32 then some t.2.2 else if t.2.2 = 32 then some t.2.1 else none
def paid (t : Gate) := t.1 && (classify t).isNone
def bindings (ctx : Bindings) (n : Nat) (t : Gate) : Bindings :=
  if t.1 then
    match classify t with
    | some i => write ctx n (maskSide (ctx i))
    | none => write (fun i => shiftSide (ctx i)) n [(0,false)]
  else write ctx n (ctx t.2.1 ++ ctx t.2.2)
def advance (ctx : Bindings) (r : Row) (g : Bool) (t : Gate) :=
  if paid t then step g r (ctx t.2.1,ctx t.2.2) else r
private theorem advance_hit (ctx : Bindings) (r : Row) (g : Bool) (n : Nat) (t : Gate)
    (guard : hit (ctx 32) g r = g) (i : Nat) :
    hit (bindings ctx n t i) g (advance ctx r g t) =
      write (fun j => hit (ctx j) g r) n (physical (fun j => hit (ctx j) g r) t) i := by
  rcases t with ⟨op,a,b⟩
  cases op
  · by_cases hi : i = n <;> simp [bindings,advance,paid,write,physical,hit,hi]
  · by_cases ha : a = 32
    · subst a
      by_cases hi : i = n <;> simp [bindings,advance,paid,classify,write,physical,hi,mask_hit,guard,Bool.and_comm]
    · by_cases hb : b = 32
      · subst b
        by_cases hi : i = n <;> simp [bindings,advance,paid,classify,write,physical,hi,ha,mask_hit,guard]
      · by_cases hi : i = n
        · simp [bindings,advance,paid,classify,write,physical,hi,ha,hb,step,hit,push]
        · simp [bindings,advance,paid,classify,write,hi,ha,hb,step,shift_hit]
def compile (ctx : Bindings) (n : Nat) (gs : List Gate) (out : Nat) :
    List (Side × Side) × Side :=
  match gs with
  | [] => ([],ctx out)
  | t :: tail =>
    let c := compile (bindings ctx n t) (n+1) tail out
    ((if paid t then [(ctx t.2.1,ctx t.2.2)] else []) ++ c.1,c.2)
theorem compile_count (ctx : Bindings) (n : Nat) (gs : List Gate) (out : Nat) :
    (compile ctx n gs out).1.length = gs.countP paid := by
  induction gs generalizing ctx n with
  | nil => rfl
  | cons t tail ih => cases h : paid t <;> simp [compile,h,ih]
theorem compile_sound (ctx : Bindings) (n : Nat) (gs : List Gate) (out : Nat)
    (g : Bool) (r : Row) (hn : 32 < n) (hg : hit (ctx 32) g r = g) :
    hit (compile ctx n gs out).2 g ((compile ctx n gs out).1.foldl (step g) r) =
      run (fun i => hit (ctx i) g r) n gs out := by
  induction gs generalizing ctx n r with
  | nil => rfl
  | cons t tail ih =>
    have h := advance_hit ctx r g n t hg
    have hg' := h 32
    simp [write, Nat.ne_of_lt hn,hg] at hg'
    have suffix :=  ih (bindings ctx n t) (n+1) (advance ctx r g t) (by omega) hg'
    have rows := funext h
    rw [rows] at suffix
    cases hv : paid t <;> simpa [compile,run,hv,advance] using suffix
end Physical
namespace Physical
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Expansion.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Core
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing.Core
def inputSide (i : Nat) : Side := [(i,false)]
def physStep (state : Nat × Row) (t : Gate) : Nat × Row :=
  (state.1+1,write state.2 state.1 (physical state.2 t))
def execute (gs : List Gate) (out v : Nat) :=
  (gs.foldl physStep (33,initial v)).2 out
private theorem run_fold (n : Nat) (r : Row) (gs : List Gate) :
    run r n gs = (gs.foldl physStep (n,r)).2 := by
  induction gs generalizing n r with
  | nil => rfl
  | cons t ts ih => exact ih _ _
private theorem compiled_input (gs : List Gate) (out v : Nat) :
    eval (compile inputSide 33 gs out).1 (compile inputSide 33 gs out).2 v = execute gs out v := by
  have h := compile_sound inputSide 33 gs out (v.testBit 32) (initial v) (by decide)
    (by simp [inputSide,hit,initial])
  simpa [eval,execute,run_fold,hit,inputSide] using h
end Physical
end PEqualNP.Research.PlaneSevenGatePaidLowerBound
open PEqualNP.Research.PlaneSevenGatePaidLowerBound.Physical PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized.Packing.Core in
theorem PEqualNP.Research.PlaneSevenGatePaidLowerBound :
    ∀ (gs : List Gate) (out : Nat),
      (∀ k, execute gs out (sig (pos k)) = true) →
      (∀ i, execute gs out (sig (neg i)) = false) →
      9 ≤ gs.countP paid := by
  intro gs out positive negative
  let program := compile inputSide 33 gs out
  have hp := PEqualNP.Research.PlaneSevenGatePaidLowerBound.Normalized program.1 program.2
    (fun k => (compiled_input gs out _).trans (positive k))
    (fun k => (compiled_input gs out _).trans (negative k))
  exact (compile_count inputSide 33 gs out) ▸ hp
