private theorem block32 : ∀ t, rowOK (idx 32 t) := by decide
private theorem blocks (b : Fin 33) (t : Fin 8) : rowOK (idx b t) := by
  fin_cases b
  · exact block0 t
  · exact block1 t
  · exact block2 t
  · exact block3 t
  · exact block4 t
  · exact block5 t
  · exact block6 t
  · exact block7 t
  · exact block8 t
  · exact block9 t
  · exact block10 t
  · exact block11 t
  · exact block12 t
  · exact block13 t
  · exact block14 t
  · exact block15 t
