private theorem pairs_ok (i : Fin 264) : rowOK i := by
  let b : Fin 33 := ⟨i.val / 8, by omega⟩
  let t : Fin 8 := ⟨i.val % 8, Nat.mod_lt _ (by decide)⟩
  have h : idx b t = i := by
    apply Fin.ext
    change 8 * (i.val / 8) + i.val % 8 = i.val
    omega
  exact h ▸ blocks b t
