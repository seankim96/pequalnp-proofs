private theorem checked (i j : Fin 257) : valid i.val j.val = true := by
  have h (q : Fin 33) (r : Nat) (hr : r < 8) (hs : r+8*q.val < 257) : valid (r+8*q.val) j.val = true := by
    match q with
    | ⟨0,_⟩ => exact block0 ⟨r,hr⟩ j
    | ⟨1,_⟩ => exact block1 ⟨r,hr⟩ j
    | ⟨2,_⟩ => exact block2 ⟨r,hr⟩ j
    | ⟨3,_⟩ => exact block3 ⟨r,hr⟩ j
