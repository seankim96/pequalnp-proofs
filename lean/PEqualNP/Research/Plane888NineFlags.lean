private def witness (i j : Nat) : Nat :=
  ((pointFlags[i]! ||| pointFlags[j]!) &&& (lineFlags[i]! ||| lineFlags[j]!)).log2

private def valid (i j : Nat) : Bool :=
  if i < j then
    let k := witness i j
    (decide (k < 52) && (!omittedFlags.testBit k)) &&
      (positiveWords[k]! &&& (negativeWords[i]! ||| negativeWords[j]!) == positiveWords[k]!)
  else true

