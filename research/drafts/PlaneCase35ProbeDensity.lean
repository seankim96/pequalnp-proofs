private def flags (k : Fin 218) := sets[k.val]!
private def row (k : Fin 218) : Nat := 52+(rows[k.val]!).val
private def flag (k : Fin 218) (f : Fin (flags k).size) : Nat := ((flags k)[f.val]!).val
private def small (k : Fin 218) (i : Fin 39) :=
    wire initial i.val (row k) = false →
      (Finset.univ.filter (fun p : Fin (flags k).size => wire initial i.val (flag k p))).card ≤ 1
private def raw (i : Fin 39) : Column :=
  if h : i.val < 32 then fixed ⟨i.val,h⟩ else
  let g := mix false (input 2) (input 6)
