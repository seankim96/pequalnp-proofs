private theorem hit (i : Fin 39) (k : Fin 218) (off : raw i (row k) = false)
    (f : Fin (flags k).size) (on : raw i (flag k f) = true) : f.val = inv k (place i k) := by
  have neg := (vals i).2 k
  have pos := (vals i).1 ((flags k)[f.val]!)
  change raw i (flag k f) = (pw i).testBit (flag k f) at pos
  have both : (pw i &&& mask k).testBit (flag k f) = true := by
    simp only [Nat.testBit_and,← pos,on,containsFlag,Bool.and_self]
  rcases checked i k (neg.symm.trans off) with empty | singleton
  · simp [empty] at both
  · rw [singleton,Nat.testBit_two_pow] at both
    have eq : place i k = flag k f := of_decide_eq_true both
    rw [eq,invert]
private theorem smallAt (k : Fin 218) (i : Nat) (off : wire initial i (row k) = false) :
    (Finset.univ.filter (fun p : Fin (flags k).size => wire initial i (flag k p))).card ≤ 1 := by
  by_cases hi : i < 39
  · let idx : Fin 39 := ⟨i,hi⟩
    have e : wire initial i = raw idx := physical idx
    rw [e] at off ⊢
    apply Finset.card_le_one.mpr
    intro a ha b hb
    apply Fin.ext
    exact (hit idx k off a (Finset.mem_filter.mp ha).2).trans (hit idx k off b (Finset.mem_filter.mp hb).2).symm
  · have e : wire initial i = fun _ => false := List.getD_eq_default _ _ (show initial.length ≤ i by change 39 ≤ i; omega)
    simp [e]

